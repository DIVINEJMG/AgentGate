ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://audoryn:audoryn@localhost:5432/audoryn
REDIS_URL=redis://localhost:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:5173
CUTOVER_STAGE=system
SHADOW_MODE_ENABLED=true
RUNTIME_EXECUTION_ENABLED=false
QSTASH_RUNTIME_EXECUTE_URL=
QSTASH_RUNTIME_SWEEP_URL=
# Web research callback defaults to the HTTPS host of QSTASH_RUNTIME_EXECUTE_URL.
# Set this only when the callback uses a different public host.
QSTASH_WEB_RESEARCH_URL=
BRAVE_SEARCH_API_KEY=
TAVILY_SEARCH_API_KEY=
WEB_RESEARCH_HOURLY_LIMIT_PER_ORGANIZATION=20
WEB_RESEARCH_PROVIDER_CALLS_PER_MINUTE=30
WEB_RESEARCH_DAILY_LIMIT_PER_ORGANIZATION=100
WEB_RESEARCH_MAX_PAGES=3
MIGRATION_EXECUTION_ENABLED=false
DATABASE_MIGRATE_ON_STARTUP=false
OBJECT_STORAGE_PROVIDER=unconfigured

AI_ENABLED=false
AI_PROVIDER=nvidia_nim
AI_PROVIDER_BASE_URL=https://integrate.api.nvidia.com/v1
# Preferred: use separate credentials for coordinator and vision roles.
AI_COORDINATOR_API_KEY=
AI_VISION_API_KEY=
# Legacy fallback only: when set, this single key is used for both roles.
AI_PROVIDER_API_KEY=
AI_COORDINATOR_MODEL=nvidia/nemotron-3-ultra-550b-a55b
AI_VISION_MODEL=nvidia/ising-calibration-1.5-31b
AI_TIMEOUT_SECONDS=60
# Runtime planning is independent of the short QStash HTTP acknowledgment.
RUNTIME_PLANNER_TIMEOUT_SECONDS=2000
AI_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=1800

CONVERSATION_ATTACHMENT_MAX_BYTES=10485760
CONVERSATION_ATTACHMENT_TEXT_MAX_CHARS=100000
VISION_SIGNED_URL_TTL_SECONDS=300

# Enable only after local migration, connection ownership and exact-resource review.
INTEGRATION_FOUNDATION_ENABLED=false
INTEGRATION_AUTH_CALLBACK_BASE_URL=
INTEGRATION_ORGANIZATION_RATE_PER_MINUTE=60
INTEGRATION_CONNECTION_RATE_PER_MINUTE=20
INTEGRATION_ORGANIZATION_CONCURRENCY=4
INTEGRATION_CONNECTION_CONCURRENCY=2

# GitHub.com App expansion: keep off until isolated migration and live acceptance.
GITHUB_EXPANDED_ENABLED=false
GITHUB_EVENTS_ENABLED=false
GITHUB_API_VERSION=2026-03-10
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CALLBACK_URL=
GITHUB_FRONTEND_URL=http://localhost:5173

# Optional coding extra: install .[coding] only on coding workers. No sandbox
# receives backend credentials. Supply a version-pinned, secret-free template.
CODING_EXECUTION_ENABLED=false
E2B_API_KEY=
CODING_TEMPLATE_ID=
CODING_ALLOWED_HOSTS=registry.npmjs.org,pypi.org,files.pythonhosted.org
CODING_GLOBAL_CONCURRENCY=2
CODING_ORGANIZATION_CONCURRENCY=1
CODING_TASK_ACTIVE_SECONDS=1800
CODING_ORGANIZATION_DAILY_SECONDS=7200
CODING_IDLE_SECONDS=300
CODING_INITIALIZATION_SECONDS=600
CODING_RETENTION_SECONDS=86400

# Planner-only ordered fallback. Apply migration 0011 before enabling.
SMART_PLANNER_ENABLED=false
AI_INTERACTIVE_TIMEOUT_SECONDS=1500
AI_INTERACTIVE_ATTEMPT_SECONDS=250
SMART_PLANNER_ATTEMPT_SECONDS=1500
SMART_PLANNER_OUTPUT_TOKENS=1800
# SMART_PLANNER_ROUTES=["nvidia_nim:moonshotai/kimi-k3","nvidia_nim:z-ai/glm-5.3","nvidia_nim:configured","nvidia_nim:z-ai/glm-5.3-flash","openrouter:nvidia/nemotron-3-super-120b-a12b:free","nvidia_nim:poolside/laguna-xs-2.1","openrouter:cohere/north-mini-code:free","openrouter:google/gemma-4-31b-it:free","openrouter:nvidia/nemotron-3.5-lightning:free","openrouter:google/gemma-4-26b-a4b-it:free","nvidia_nim:openai/gpt-oss-20b","openrouter:thinkingmachines/inkling:free"]
# Optional compatibility overrides keyed by connection:model. Built-in profiles cover all 12.
SMART_PLANNER_MODEL_PROFILES={}
OPENROUTER_API_KEY=
OPENROUTER_PLANNER_DATA_ALLOWED=false
OPENROUTER_ALLOWED_PROVIDERS=[]
SMART_PLANNER_ORG_CONCURRENCY=2
SMART_PLANNER_ORG_REQUESTS_PER_MINUTE=20
SMART_PLANNER_ORG_TOKENS_PER_DAY=50000000

AI_INTERACTIVE_ROUTES=["nvidia_nim:openai/gpt-oss-20b","groq:qwen/qwen3.8-27b","nvidia_nim:configured","openrouter:cohere/north-mini-code:free","nvidia_nim:z-ai/glm-5.3","nvidia_nim:poolside/laguna-xs-2.1","nvidia_nim:moonshotai/kimi-k3"]
AI_COMPLEX_ROUTES=["groq:qwen/qwen3.8-27b","nvidia_nim:configured","nvidia_nim:moonshotai/kimi-k3","nvidia_nim:openai/gpt-oss-20b","nvidia_nim:poolside/laguna-xs-2.1"]
AI_INTERACTIVE_RESERVED_SLOTS=1
AI_INTERACTIVE_RESERVED_REQUESTS=5
AI_INTERACTIVE_RESERVED_TOKENS=500000
AI_ACCOUNT_CONCURRENCY=4

# Additional text endpoints, unqualified until benchmarked. See docs/ai-model-connections.md.
# Apply 0013_ai_connections before restarting the backend with this code.
GROQ_API_KEY=
HF_TOKEN=
# Default connection presets exist but are disabled. No new ranking is enabled here.
# AI_TEXT_CONNECTIONS replaces the named connection map; keep values on ONE line.
AI_TEXT_API_KEYS={}
# AI_TEXT_CONNECTIONS={"groq":{"base_url":"https://api.groq.com/openai/v1","hosting_provider":"groq","credential_ref":"groq","schema_mode":"groq_strict","enabled":false,"data_allowed":false},"hf_featherless":{"base_url":"https://router.huggingface.co/v1","hosting_provider":"featherless-ai","credential_ref":"huggingface","enabled":false,"data_allowed":false,"billing_required":true,"billing_allowed":false},"hf_novita":{"base_url":"https://router.huggingface.co/v1","hosting_provider":"novita","credential_ref":"huggingface","enabled":false,"data_allowed":false,"billing_required":true,"billing_allowed":false}}

# GitHub account login: uses the same App credentials as the connector.
# Enable after applying docs/sql/github_login_neon.sql and adding this callback to the App.
GITHUB_LOGIN_ENABLED=false
GITHUB_LOGIN_CALLBACK_URL=https://YOUR_BACKEND_HOST/api/v2/auth/github/callback
# Existing GITHUB_FRONTEND_URL must be the frontend origin (no query or fragment).

# Signed read-only data for Audoryn Console (docs/integration/console-admin-reads-plan.md).
# Off by default; every /internal/console/v1 route answers 404 until enabled with a key.
# Secret: at least 32 random bytes, base64url. Use a new key per environment; never commit it.
CONSOLE_READS_ENABLED=false
CONSOLE_READS_AUDIENCE=agentgate
CONSOLE_READS_KEY_ID=
CONSOLE_READS_KEY_SECRET=
CONSOLE_READS_KEY_SCOPES=visibility.read,observability.read
# Only during a key rotation:
CONSOLE_READS_PREVIOUS_KEY_ID=
CONSOLE_READS_PREVIOUS_KEY_SECRET=
CONSOLE_READS_PREVIOUS_KEY_SCOPES=
CONSOLE_READS_CLOCK_SKEW_SECONDS=60
CONSOLE_READS_RATE_PER_MINUTE=120
CONSOLE_READS_STATEMENT_TIMEOUT_MS=3000
