ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://audoryn:audoryn@localhost:5432/audoryn
REDIS_URL=redis://localhost:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:5173
CUTOVER_STAGE=system
SHADOW_MODE_ENABLED=true
RUNTIME_EXECUTION_ENABLED=false
QSTASH_RUNTIME_EXECUTE_URL=
QSTASH_RUNTIME_SWEEP_URL=
MIGRATION_EXECUTION_ENABLED=false
OBJECT_STORAGE_PROVIDER=unconfigured

AI_ENABLED=false
AI_PROVIDER=nvidia_nim
AI_PROVIDER_BASE_URL=https://integrate.api.nvidia.com/v1
AI_PROVIDER_API_KEY=
AI_COORDINATOR_MODEL=nvidia/nemotron-3-ultra-550b-a55b
AI_VISION_MODEL=nvidia/ising-calibration-1.5-31b
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=1800
