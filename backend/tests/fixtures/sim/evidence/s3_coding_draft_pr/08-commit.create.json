   "changes": [
    {
     "path": "README.md",
     "content": "# school\n\n## Setup\n\n1. Clone the repository:\n\n   ```bash\n   git clone https://github.com/DIVINEJMG/school.git\n   cd school\n   ```\n\n2. Run the helper script to check your environment:\n\n   ```bash\n   bash scripts/setup.sh\n   ```\n\nThe script checks that `git` is installed and prints the next steps."
    },
    {
     "path": "scripts/setup.sh",
     "content": "#!/usr/bin/env bash\n# Checks the tools this project needs and prints the next steps.\nset -euo pipefail\n\nif ! command -v git >/dev/null 2>&1; then\n  echo \"git is not installed. Install it from https://git-scm.com and run this script again.\" >&2\n  exit 1\nfi\n\necho \"git $(git --version | awk '{print $3}') found.\"\necho \"Setup complete. See README.md for the next steps.\"\n"
    }
   ],
   "message": "Add a setup section to the README and a helper script"
