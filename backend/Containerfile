# The single service (SERVICE_ROLE=all, the default): the core API and the execution service in one
# process, as deployed before the split. Build from the repository root:
#   docker build -f backend/Containerfile .
# The split images are backend/Containerfile.api and services/execution/Containerfile (Phase 5).
FROM python:3.13-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# The repository's layout: the shared code finds the core's migrations beside it (backend/alembic.ini).
WORKDIR /app/backend

COPY packages/shared /app/packages/shared
COPY services/execution /app/services/execution
COPY backend/pyproject.toml ./pyproject.toml
COPY backend/app ./app
COPY backend/migrations ./migrations
COPY backend/alembic.ini ./alembic.ini

RUN pip install --upgrade pip \
    && pip install -e '/app/packages/shared[coding]' -e /app/services/execution -e . \
    && playwright install --with-deps chromium

RUN useradd --create-home --uid 10001 audoryn \
    && chown -R audoryn:audoryn /app /ms-playwright

USER audoryn

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips=*"]
