# The core API alone (SERVICE_ROLE=api, architecture plan Phases 3-5): no step runtime, no Playwright,
# no Chromium. Build from the repository root:
#   docker build -f backend/Containerfile.api .
FROM python:3.13-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    SERVICE_ROLE=api

# The repository's layout: the shared code finds the core's migrations beside it (backend/alembic.ini).
WORKDIR /app/backend

COPY packages/shared /app/packages/shared
COPY backend/pyproject.toml ./pyproject.toml
COPY backend/app ./app
COPY backend/migrations ./migrations
COPY backend/alembic.ini ./alembic.ini

RUN pip install --upgrade pip \
    && pip install -e '/app/packages/shared[coding]' -e .

RUN useradd --create-home --uid 10001 audoryn \
    && chown -R audoryn:audoryn /app

USER audoryn

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips=*"]
