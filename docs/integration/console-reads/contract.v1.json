    "data_notifications": {
      "description": "Matches Console's ProductNotification model exactly.",
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "severity",
          "title",
          "body",
          "href",
          "fingerprint"
        ],
        "properties": {
          "source": {
            "enum": [
              "audoryn.incident",
              "audoryn.queue"
            ]
          },
          "severity": {
            "enum": [
              "info",
              "success",
              "warning",
              "critical"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "body": {
            "type": "string",
            "maxLength": 4000
          },
          "href": {
            "enum": [
              "/operations/system-health",
              "/operations/queues"
            ]
          },
          "fingerprint": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^audoryn-[a-z0-9:-]+$"
          }
        }
      }
    },
